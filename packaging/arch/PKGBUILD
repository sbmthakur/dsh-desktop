# Maintainer: Shubham <sbmthakur@gmail.com>

pkgname=dsh-desktop-bin
_appname=dsh-desktop
# Upstream's release workflow sets the app version from the git tag, so the tag
# is the version; the 0.1.1 committed in package.json is a placeholder that no
# release ever bumps. A pkgver cannot contain a hyphen, so the tag's `-linux.1`
# becomes `.linux.1` here. This still orders after 0.6.3 and before 0.6.4.
pkgver=0.7.1.linux.1
_tag='v0.7.1-linux.1'
pkgrel=1
pkgdesc='Local-first desktop app for DeepSeek Harness'
arch=('x86_64')
url='https://github.com/sbmthakur/dsh-desktop'
# MIT covers the desktop shell. The bundle additionally carries a prebuilt
# libvips under the LGPL and a long permissive tail; see THIRD-PARTY-NOTICES.md
# and LICENSES.chromium.html, both installed under /usr/share/licenses.
# Chromium's own set is not a single SPDX identifier, so it is referenced
# rather than enumerated; bare 'custom' is no longer accepted.
# One identifier per licence file the package actually installs. Enumerating
# the whole permissive tail here claimed more than the artifact evidences —
# namcap wants a file per uncommon identifier — and that tail is attribution
# only, discharged by the notices each package carries in its own directory.
license=(
  'MIT'
  'LGPL-3.0-or-later'
  'LicenseRef-Chromium'
  'LicenseRef-third-party-notices'
)

# Resolved from the DT_NEEDED entries of the shipped binary and its bundled
# libraries, minus everything gtk3 already pulls in. The upstream pacman target
# lists c-ares, ffmpeg, libevent, libvpx, libxslt, minizip, re2 and snappy as
# well; none of those are real here, because this build bundles its own copies
# rather than linking the system ones.
depends=(
  'gtk3'
  'nss'
  'alsa-lib'
  'mesa'
  'systemd-libs'
)
optdepends=(
  'openssh: Pinggy fallback tunnel when Cloudflare is unreachable'
  'cloudflared: use a system tunnel binary instead of downloading one at runtime'
  'libnotify: desktop notifications'
)
makedepends=('imagemagick')
provides=("${_appname}=${pkgver}")
conflicts=("${_appname}")

# Prebuilt Electron. Stripping its binaries breaks the bundled V8 snapshot and
# the crashpad handler, and there are no debug symbols worth extracting.
options=('!strip' '!debug')

source=(
  "${_appname}-${pkgver}.tar.gz::${url}/releases/download/${_tag}/${_appname}-linux-x64.tar.gz"
  "${_appname}.desktop"
)
sha256sums=(
  'b5f28c89365cf5e3be1315d29d4e7a5a905e86c3405400c530d424119b76e3e7'
  'e5d5093cae55bff904322f93bc9d51a6cb6456e21d10b76346d39402face9092'
)

package() {
  local _srcdir="${srcdir}/${_appname}-linux-x64"
  local _destdir="${pkgdir}/opt/${_appname}"

  install -dm755 "${_destdir}"
  cp -a "${_srcdir}/." "${_destdir}/"

  # Chromium's setuid sandbox helper. Electron finds it, checks the mode, and
  # refuses to start if it is not root-owned and setuid, so a plain 0755 copy
  # is worse than no helper at all.
  chown root:root "${_destdir}/chrome-sandbox"
  chmod 4755 "${_destdir}/chrome-sandbox"

  install -dm755 "${pkgdir}/usr/bin"
  ln -s "/opt/${_appname}/${_appname}" "${pkgdir}/usr/bin/${_appname}"

  # The shipped icon is 1024x1024; hicolor tops out at 512x512.
  magick "${_destdir}/resources/icon.png" -resize 512x512 "${srcdir}/icon-512.png"
  install -Dm644 "${srcdir}/icon-512.png" \
    "${pkgdir}/usr/share/icons/hicolor/512x512/apps/${_appname}.png"

  install -Dm644 "${srcdir}/${_appname}.desktop" \
    "${pkgdir}/usr/share/applications/${_appname}.desktop"

  # Licence texts travel inside the artifact; surface them where pacman and
  # namcap expect to find them rather than only under /opt.
  install -dm755 "${pkgdir}/usr/share/licenses/${pkgname}"
  local _licence
  for _licence in LICENSE.txt LICENSE.electron.txt LICENSE.lgpl-3.0.txt \
                  THIRD-PARTY-NOTICES.md LICENSES.chromium.html; do
    if [[ -f "${_destdir}/${_licence}" ]]; then
      ln -s "/opt/${_appname}/${_licence}" \
        "${pkgdir}/usr/share/licenses/${pkgname}/${_licence}"
    fi
  done
}
